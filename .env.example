GEMINI_API_KEY="AIzaSy_YOUR_GOOGLE_AI_STUDIO_KEY_HERE"


# 2. Application API Key Authentication (x-api-key middleware header)
# Required for testing POST /api/v1/convert
APP_API_KEY="ciap-secret-key-2026"

# 3. Webhook Dispatcher HMAC Signing Secret
WEBHOOK_SECRET="whsec_btin337_ciap_99481a"

# 4. Default External Webhook Receiver URL (optional)
DEFAULT_WEBHOOK_URL="https://webhook.site/your-uuid-here"
