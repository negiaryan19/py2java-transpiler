# ==============================================================================
# J-Forge // BTIN337 GenAI Applications (CIA-P) Environment Template
# Course: Continuous Internal Assessment Practical (20 Marks)
# NOTE: Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to GitHub.
# ==============================================================================

# 1. Google AI Studio Gemini API Key (Direct Integration)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_YOUR_GOOGLE_AI_STUDIO_KEY_HERE"


# 2. Application API Key Authentication (x-api-key middleware header)
# Generate a 32+ char cryptographically random secret before deploying
APP_API_KEY="REPLACE_WITH_YOUR_GENERATED_APP_API_KEY"

# 3. Webhook Dispatcher HMAC Signing Secret
WEBHOOK_SECRET="REPLACE_WITH_YOUR_GENERATED_WEBHOOK_SECRET"

# 4. Default External Webhook Receiver URL (optional)
DEFAULT_WEBHOOK_URL="https://webhook.site/your-uuid-here"

# 5. Signed Session Secret (Required for all login methods)
AUTH_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET"

# 6. Google OAuth 2.0 (Optional — for "Continue with Google" button)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# 7. Neon Postgres Database URL (Required for Email + Password login)
# Automatically provisioned via `vercel integration add neon`
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
